// Puentara lead follow-up for Google Sheets (Puentara is a fictional demo company).
// GENERATED by scripts/bundle.js from src/*.js, data/leads.csv and apps-script/Code.gs.
// Do not edit this file: edit those files, then run `npm run bundle`.

// ===== src/config.js =====
// Settings and sheet layout. Everything a client might want to change is here
// or on the Config tab (key / value rows, read by readConfig below).

// Defaults. The Config tab can override each one.
var DEFAULT_CONFIG = {
  // Business days after the demo request / after the previous draft.
  touch1_days: 1,
  touch2_days: 3,
  touch3_days: 7,
  // Local window for "Send after", in the LEAD's time zone. A sensible
  // default, not legal advice: each client checks the rules that apply to them.
  window_start: "09:00",
  window_end: "18:00",
  window_days: "Mon,Tue,Wed,Thu,Fri",
  booking_link: "https://example.com/book/puentara-demo",
};

// Statuses that end the sequence for good. "replied" means a person answers.
var LEAD_STATUSES = ["new", "contacted", "replied", "booked", "closed", "do_not_contact"];
// Other names people type for the same status. A status that matches none
// of these (and is not blank) holds the lead: we never guess.
var EXTRA_STATUS_NAMES = {
  do_not_contact: ["dnc", "opted out", "opt-out", "opt out", "unsubscribed", "unsubscribe",
    "do not call", "not interested", "dado de baja", "baja", "no contactar", "no llamar",
    "no interesado", "no interesada"],
  replied: ["respondio", "respondida"],
  booked: ["scheduled", "agendada", "reunion agendada"],
  closed: ["lost", "bounced", "perdido", "rebotado"],
};

// --- Columns ----------------------------------------------------------------
// Leads tab. Each column is found by its English or Spanish header (from
// strings.js) or by one of these extra names. Add your own here if needed.
var LEAD_COLUMNS = [
  "first_name", "company", "email", "phone", "language", "time_zone", "interest",
  "rep_name", "requested_on", "status", "opt_out", "touches", "last_drafted",
  "next_due", "appointment", "reminder_drafted", "notes", "last_reply",
];
var REQUIRED_LEAD_COLUMNS = ["first_name", "email", "status"];
var EXTRA_COLUMN_ALIASES = {
  first_name: ["name", "first", "nombre de pila"],
  company: ["business", "negocio"],
  email: ["e-mail", "email address", "correo electronico"],
  phone: ["phone number", "telefono", "celular"],
  time_zone: ["timezone", "tz", "zona horaria"],
  rep_name: ["rep", "owner", "sales rep", "vendedor", "asesor"],
  requested_on: ["created", "date", "fecha", "fecha de solicitud"],
  opt_out: ["unsubscribed", "baja"],
  appointment: ["appointment time", "meeting", "cita", "reunion"],
  last_reply: ["reply", "respuesta"],
};

// The columns the tool writes back. Everything else is the team's.
var WRITE_BACK_COLUMNS = ["touches", "last_drafted", "next_due", "reminder_drafted"];

// Suppression tab: anyone who opted out, by email and phone.
var SUPPRESSION_COLUMNS = ["email", "phone", "reason", "added_on"];

// Values in the Opt-out column that mean "yes".
var OPT_OUT_YES = ["yes", "y", "true", "x", "1", "si", "opted out", "opt out"];

var WEEKDAY_IDS = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"];

// Config tab (2 columns: key, value) -> settings, with defaults for anything
// missing. Bad values throw a clear error naming the key.
function readConfig(table) {
  var config = Object.assign({}, DEFAULT_CONFIG);
  (table || []).forEach(function (row) {
    var key = foldText(row[0]).replace(/ /g, "_");
    if (key in DEFAULT_CONFIG && String(row[1] == null ? "" : row[1]).trim() !== "") {
      config[key] = typeof DEFAULT_CONFIG[key] === "number" ? Number(row[1]) : String(row[1]).trim();
    }
  });
  ["touch1_days", "touch2_days", "touch3_days"].forEach(function (key) {
    if (!(config[key] >= 0 && config[key] === Math.floor(config[key]))) {
      throw new Error("Config: " + key + " must be a whole number of business days, like 3.");
    }
  });
  var start = clockMinutes(config.window_start);
  var end = clockMinutes(config.window_end);
  if (start === null || end === null || start >= end) {
    throw new Error("Config: window_start and window_end must look like 09:00 and 18:00, start before end.");
  }
  var days = String(config.window_days).split(/[\s,]+/).map(function (d) {
    return WEEKDAY_IDS.indexOf(foldText(d).slice(0, 3));
  });
  if (!days.length || days.indexOf(-1) !== -1) {
    throw new Error("Config: window_days must list days like Mon,Tue,Wed,Thu,Fri.");
  }
  if (!/^https:\/\/\S+$/.test(config.booking_link)) {
    throw new Error("Config: booking_link must be a full https:// link.");
  }
  config.window = { start: start, end: end, days: days };
  return config;
}

// "09:00" -> 540 minutes after midnight, or null.
function clockMinutes(text) {
  var m = /^(\d{1,2}):(\d{2})$/.exec(String(text || "").trim());
  if (!m || Number(m[1]) > 24 || Number(m[2]) > 59) return null;
  return Number(m[1]) * 60 + Number(m[2]);
}

// ===== src/followup.js =====
// The follow-up decision for every lead: draft, remind, hold, or skip
// (and why). Plain functions on a 2D array (the Leads tab or a CSV), so the
// same code runs in Apps Script and in the Node demo and tests.
//
// Order of the checks matters and is deliberate:
//   1. opted out (own row, or email/phone on the suppression list): beats all
//   2. looks like a support case (lost card, fraud...): route to support
//   3. any Last reply: a person answers (never an automatic follow-up)
//   4. unknown Status: hold; Closed / Replied / sequence finished: stop
//   5. missing or invalid time zone: hold, never guess the lead's hours
//   6. Booked: appointment reminder; otherwise the next follow-up if due
//   7. missing or unusable placeholder value: hold with the reason
//   8. outside the lead's local hours: "waiting", drafted by a later run

var MAX_TOUCHES = 3;

// Notes or a reply that look like an urgent support case. Shared ticket
// categories from the demo world; patterns adapted from bilingual-sla-tracker
// (src/config.js CATEGORY_KEYWORDS). Run on folded text, first match wins.
var SUPPORT_PATTERNS = [
  // "uso" alone is left out on purpose: folded, "usó" (used) and "uso" (use)
  // look the same, and "el uso de tarjetas" is a normal sales question.
  ["card_lost_stolen", [/\b(card|cards|tarjeta|tarjetas)\b/,
    /\b(lost|lose|stolen|stole|cloned|someone used|used my card|using my card|perdi|perdida|perdio|extravie|extraviada|robaron|robada|robo|usaron|usando|alguien (la |lo )?uso|clonaron|clonada|clonado)\b/]],
  ["account_access", [/\b(can'?t|cannot|unable to) (log ?in|sign ?in|access|get into)\b|\blocked\b|\bhacked\b|\bforgot my password\b|\bno puedo (entrar|ingresar|iniciar sesion|acceder)\b|\b(hackearon|hackeada|hackeado|bloquearon|bloqueada|bloqueado|bloqueo)\b|\bolvide mi contrasena\b/]],
  ["charge_dispute", [/\b(fraud|fraudulent|unauthori[sz]ed|fraude|no reconozco|don'?t recognize|didn'?t make|no hice|dispute|chargeback|disputa|contracargo|someone is using|alguien (la|lo) esta usando)\b/]],
  ["transfer_failed_pending", [/\b(transfer|transfers|transferencia|transferencias)\b/,
    /\b(failed|pending|didn'?t arrive|never arrived|stuck|fallo|fallida|pendiente|no (me )?llego|no ha llegado)\b/]],
];

// A pricing or approval question: the rep answers on a call, the draft
// only defers to it (no numbers, no promises).
var PRICING_PATTERN = /\b(price|prices|pricing|cost|costs|how much|fee|fees|rate|rates|quote|approval|approve|approved|credit|loan|precio|precios|cuanto cuesta|cuanto cobran|costo|costos|comision|comisiones|tarifa|tarifas|cotizacion|aprobacion|aprueban|aprobado|credito|prestamo)\b/;

function supportCategory(text) {
  var folded = foldText(text);
  for (var i = 0; i < SUPPORT_PATTERNS.length; i++) {
    var all = SUPPORT_PATTERNS[i][1].every(function (re) { return re.test(folded); });
    if (all) return SUPPORT_PATTERNS[i][0];
  }
  return "";
}

function asksAboutPricing(text) {
  return PRICING_PATTERN.test(foldText(text));
}

// --- Reading the sheet --------------------------------------------------------

function columnAliases(key) {
  var names = [key, key.replace(/_/g, " "), STRINGS.en["header." + key], STRINGS.es["header." + key]]
    .concat(EXTRA_COLUMN_ALIASES[key] || []);
  return names.map(foldText);
}

// headerRow -> { key: columnIndex }. Throws a clear error naming the missing
// required columns, in the sheet's language.
function mapColumns(headerRow, lang) {
  var folded = headerRow.map(foldText);
  var map = {};
  LEAD_COLUMNS.forEach(function (key) {
    var aliases = columnAliases(key);
    for (var i = 0; i < folded.length; i++) {
      if (aliases.indexOf(folded[i]) !== -1 && !(key in map)) { map[key] = i; return; }
    }
  });
  var missing = REQUIRED_LEAD_COLUMNS.filter(function (key) { return !(key in map); });
  if (missing.length) {
    var names = missing.map(function (key) { return t(lang, "header." + key); });
    throw new Error(t(lang, "error.missing_columns", { columns: names.join(", ") }));
  }
  return map;
}

// "es" when most headers are the Spanish ones. New headers and the menu
// follow the language the sheet already uses.
function sheetLanguage(headerRow) {
  var en = 0, es = 0;
  (headerRow || []).map(foldText).forEach(function (h) {
    LEAD_COLUMNS.forEach(function (key) {
      if (h === foldText(STRINGS.en["header." + key])) en++;
      if (h === foldText(STRINGS.es["header." + key])) es++;
    });
  });
  return es > en ? "es" : "en";
}

// Table -> leads: { row (sheet row number), <column>: text, status: id }.
function readLeads(table, lang) {
  var map = mapColumns(table[0] || [], lang);
  var leads = table.slice(1).map(function (cells, i) {
    var lead = { row: i + 2 };
    LEAD_COLUMNS.forEach(function (key) {
      var v = key in map ? cells[map[key]] : "";
      lead[key] = v == null ? "" : String(v).trim();
    });
    lead.blank = cells.every(function (v) { return String(v == null ? "" : v).trim() === ""; });
    // Keep what the person typed (shown in the queue). Blank means New; any
    // other text we don't recognise is "unknown" and holds the lead.
    lead.statusRaw = lead.status;
    lead.status = lead.status ? (idFromLabel("status", lead.status, LEAD_STATUSES, EXTRA_STATUS_NAMES) || "unknown") : "new";
    return lead;
  });
  return { map: map, leads: leads };
}

function validEmail(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email || ""));
}

// --- Deciding -----------------------------------------------------------------

// ctx: { now (ms), config, suppression }. Returns a decision:
// { row, lead, action, reason: { key, vars }, lang, flags, template, draft,
//   sendAfter, updates }. `updates` are the write-back values for this row.
function decideLead(lead, ctx) {
  var language = leadLanguage(lead.language, lead.notes, lead.last_reply);
  var d = {
    row: lead.row, lead: lead, action: "", reason: null, lang: language.lang,
    flags: language.note ? ["flag." + language.note] : [], template: "", draft: null,
    sendAfter: null, updates: {},
  };
  function done(action, key, vars) {
    d.action = action;
    d.reason = key ? { key: key, vars: vars || {} } : null;
    return d;
  }

  var own = ownOptOut(lead);
  if (own) return done("opted_out", own.key, own.vars);
  if (isSuppressed(lead, ctx.suppression)) return done("opted_out", "optout.suppressed");
  var category = supportCategory(lead.notes + " \n " + lead.last_reply);
  if (category) return done("support", "support.route", { category: category });
  // Any reply that is not an opt-out goes to a person, whatever the Status:
  // the opt-out list will miss some wordings, so no reply ever leads to an
  // automatic follow-up. The rep clears Last reply to resume the sequence.
  if (lead.last_reply) return done("needs_person", "needs_person.reply");
  if (lead.status === "unknown") return done("hold", "held.status", { status: lead.statusRaw });
  if (lead.status === "closed") return done("stopped", "stopped.closed");
  if (lead.status === "replied") return done("needs_person", "needs_person.replied");
  var touches = Math.max(0, parseInt(lead.touches, 10) || 0);
  if (lead.status !== "booked" && touches >= MAX_TOUCHES) {
    return done("stopped", "stopped.finished", { count: touches });
  }

  var tzProblem = timeZoneProblem(lead.time_zone);
  if (tzProblem) return done("hold", "held." + tzProblem + "_tz", { tz: lead.time_zone });
  var tz = lead.time_zone;
  var now = localNow(ctx.now, tz);
  var days = ctx.config.window.days;
  var values = {
    first_name: lead.first_name, company: lead.company, rep_name: lead.rep_name,
    booking_link: ctx.config.booking_link,
  };

  if (lead.status === "booked") {
    var appt = parseDateTime(lead.appointment);
    if (!appt) return done("hold", "held.missing_appointment");
    if (lead.reminder_drafted) return done("not_due", "not_due.reminder_done");
    if (appt.date < now.date || (appt.date === now.date && appt.minutes <= now.minutes)) {
      return done("stopped", "stopped.past");
    }
    var remindOn = businessDayBefore(appt.date, days);
    if (now.date < remindOn) {
      d.updates.next_due = remindOn;
      return done("not_due", "not_due.reminder", { date: remindOn });
    }
    values.appointment_time = formatAppointment(appt, tz, d.lang);
    d.template = "reminder";
    if (!finishDraft(d, values, ctx, tz)) return d;
    d.updates = { reminder_drafted: now.date, next_due: "" };
    return waitIfOutsideWindow(done("reminder"));
  }

  // Follow-up sequence: touch 1 counts from the request date, later touches
  // from the last draft. Touches already drafted today are never repeated.
  var requested = parseDate(lead.requested_on);
  var last = parseDate(lead.last_drafted);
  var base = touches === 0 ? requested : (last || requested);
  if (!base) return done("hold", "held.missing_value", { field: touches === 0 ? "requested_on" : "last_drafted" });
  var gaps = [ctx.config.touch1_days, ctx.config.touch2_days, ctx.config.touch3_days];
  var due = addBusinessDays(base, gaps[touches], days);
  if (last === now.date) return done("not_due", "not_due.today");
  if (now.date < due) {
    d.updates.next_due = due;
    return done("not_due", "not_due.touch", { date: due });
  }
  d.template = asksAboutPricing(lead.notes + " \n " + lead.last_reply) ? "needs_rep" : "touch" + (touches + 1);
  if (d.template === "needs_rep") d.flags.unshift("flag.needs_rep");
  if (!finishDraft(d, values, ctx, tz)) return d;
  d.updates = {
    touches: String(touches + 1),
    last_drafted: now.date,
    next_due: touches + 1 < MAX_TOUCHES ? addBusinessDays(now.date, gaps[touches + 1], days) : "",
  };
  return waitIfOutsideWindow(done("draft"));
}

// Check the email, fill the template and work out "send after".
// Returns false (and marks the decision "hold") when something is missing.
function finishDraft(d, values, ctx, tz) {
  var problems = [];
  if (!validEmail(d.lead.email)) {
    problems.push({ key: d.lead.email ? "held.invalid_value" : "held.missing_value", vars: { field: "email" } });
  }
  var filled = fillTemplate(d.lang, d.template, values);
  problems = problems.concat(filled.problems);
  if (problems.length) {
    d.action = "hold";
    d.reason = problems[0];
    d.moreReasons = problems.slice(1);
    return false;
  }
  d.draft = { to: d.lead.email, subject: filled.subject, body: filled.body };
  var win = sendWindow(ctx.now, tz, ctx.config.window);
  d.sendAfter = { inWindow: win.inWindow, date: win.date, minutes: win.minutes, tz: tz };
  return true;
}

// Outside the lead's local window: no draft yet and nothing stamped, so a
// later (hourly) run drafts it once the window opens. The text is kept so
// the demo and the preview can show what will be drafted.
function waitIfOutsideWindow(d) {
  if (d.sendAfter.inWindow) return d;
  d.action = "waiting";
  d.updates = {};
  return d;
}

// The whole run. options: { now (ms), config, suppressionRows, runDate }.
// Throws if the templates fail the lint: nothing is drafted from a bad template.
function planRun(table, options) {
  var lang = sheetLanguage(table[0]);
  var problems = lintTemplates(TEMPLATES);
  if (problems.length) throw new Error(t(lang, "error.lint", { problems: problems.join("; ") }));
  var read = readLeads(table, lang);
  var config = options.config || readConfig([]);
  var leads = read.leads.filter(function (lead) { return !lead.blank; });
  var suppression = buildSuppression(leads, options.suppressionRows || [], options.runDate);
  var ctx = { now: options.now, config: config, suppression: suppression };
  var decisions = leads.map(function (lead) { return decideLead(lead, ctx); });
  return { lang: lang, map: read.map, decisions: decisions, suppression: suppression };
}

// ===== src/hours.js =====
// Time zones, business days and the lead's local "send after" window.
//
// No date library: Intl.DateTimeFormat with a timeZone works in Node and in
// Apps Script (V8). Dates are handled as "YYYY-MM-DD" text and times as
// minutes after midnight, so the math is easy to read and to test.
// The run time ("now") is a real instant (milliseconds); everything else is
// the lead's own wall-clock time.

// Display names for the time zones the demo uses. Others show the IANA city.
var CITY_NAMES = {
  "America/New_York": ["New York", "Nueva York"],
  "America/Chicago": ["Chicago", "Chicago"],
  "America/Los_Angeles": ["Los Angeles", "Los Ángeles"],
  "America/Bogota": ["Bogotá", "Bogotá"],
  "America/Mexico_City": ["Mexico City", "Ciudad de México"],
  "America/Lima": ["Lima", "Lima"],
};

var DATE_NAMES = {
  en: {
    days: ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    months: ["January", "February", "March", "April", "May", "June", "July",
      "August", "September", "October", "November", "December"],
  },
  es: {
    days: ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"],
    months: ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio",
      "agosto", "septiembre", "octubre", "noviembre", "diciembre"],
  },
};

// "" when the time zone is usable, else "missing" or "invalid".
// Only "Area/City" names (America/Bogota) and UTC are accepted: short forms
// like "EST" or "Eastern" are ambiguous, and we never guess a lead's hours.
function timeZoneProblem(tz) {
  var name = String(tz == null ? "" : tz).trim();
  if (!name) return "missing";
  if (name !== "UTC" && !/^[A-Za-z_]+\/[A-Za-z_\/-]+$/.test(name)) return "invalid";
  try {
    new Intl.DateTimeFormat("en-US", { timeZone: name });
    return "";
  } catch (e) {
    return "invalid";
  }
}

// The lead's wall clock at instant `ms`: { date: "YYYY-MM-DD", minutes, weekday }.
function localNow(ms, tz) {
  var parts = {};
  new Intl.DateTimeFormat("en-US", {
    timeZone: tz, hourCycle: "h23", year: "numeric", month: "2-digit",
    day: "2-digit", hour: "2-digit", minute: "2-digit",
  }).formatToParts(new Date(ms)).forEach(function (p) { parts[p.type] = p.value; });
  // Some engines write midnight as "24"; treat it as 0.
  var hour = Number(parts.hour) % 24;
  var date = parts.year + "-" + parts.month + "-" + parts.day;
  return { date: date, minutes: hour * 60 + Number(parts.minute), weekday: weekdayOf(date) };
}

// "YYYY-MM-DD" -> 0 (Sunday) .. 6 (Saturday).
function weekdayOf(date) {
  var p = date.split("-").map(Number);
  return new Date(Date.UTC(p[0], p[1] - 1, p[2])).getUTCDay();
}

function addDays(date, n) {
  var p = date.split("-").map(Number);
  return new Date(Date.UTC(p[0], p[1] - 1, p[2] + n)).toISOString().slice(0, 10);
}

// n business days after `date` (days = weekday numbers that count, Mon-Fri
// by default). Holidays are not modelled (out of scope).
function addBusinessDays(date, n, days) {
  var d = date;
  var left = n;
  while (left > 0) {
    d = addDays(d, 1);
    if (days.indexOf(weekdayOf(d)) !== -1) left--;
  }
  return d;
}

// The last business day before `date` (Friday for a Monday appointment).
function businessDayBefore(date, days) {
  var d = addDays(date, -1);
  while (days.indexOf(weekdayOf(d)) === -1) d = addDays(d, -1);
  return d;
}

// "2026-11-24" or a "2026-11-24 10:00" cell -> "2026-11-24", or null.
function parseDate(text) {
  var m = /^(\d{4})-(\d{2})-(\d{2})(?:[ T]\d{1,2}:\d{2})?$/.exec(String(text == null ? "" : text).trim());
  if (!m) return null;
  var date = m[1] + "-" + m[2] + "-" + m[3];
  return addDays(date, 0) === date ? date : null; // rejects 2026-02-31
}

// "2026-11-25 10:00" -> { date, minutes }, or null.
function parseDateTime(text) {
  var m = /^(\d{4}-\d{2}-\d{2})[ T](\d{1,2}:\d{2})$/.exec(String(text == null ? "" : text).trim());
  if (!m || !parseDate(m[1])) return null;
  var minutes = clockMinutes(m[2]);
  return minutes === null || minutes >= 1440 ? null : { date: m[1], minutes: minutes };
}

// When a draft for this lead may be sent, in the lead's time:
// { inWindow: true, date, minutes } now, or the start of the next window.
function sendWindow(ms, tz, window) {
  var now = localNow(ms, tz);
  var workday = window.days.indexOf(now.weekday) !== -1;
  if (workday && now.minutes >= window.start && now.minutes < window.end) {
    return { inWindow: true, date: now.date, minutes: now.minutes };
  }
  var date = now.date;
  if (!(workday && now.minutes < window.start)) {
    do { date = addDays(date, 1); } while (window.days.indexOf(weekdayOf(date)) === -1);
  }
  return { inWindow: false, date: date, minutes: window.start };
}

function cityName(tz, lang) {
  var names = CITY_NAMES[tz];
  if (names) return names[lang === "es" ? 1 : 0];
  return String(tz).split("/").pop().replace(/_/g, " ");
}

function pad2(n) {
  return (n < 10 ? "0" : "") + n;
}

// Short label for the rep: "Tue Nov 24, 09:00 (Los Angeles time)" /
// "mar 24 nov, 09:00 (hora de Los Ángeles)". 24-hour clock, no ambiguity.
function shortLocalTime(date, minutes, tz, lang) {
  var names = DATE_NAMES[lang === "es" ? "es" : "en"];
  var p = date.split("-").map(Number);
  var day = names.days[weekdayOf(date)].slice(0, 3);
  var month = names.months[p[1] - 1].slice(0, 3);
  var clock = pad2(Math.floor(minutes / 60)) + ":" + pad2(minutes % 60);
  var when = lang === "es" ? day + " " + p[2] + " " + month + ", " + clock : day + " " + month + " " + p[2] + ", " + clock;
  return when + " (" + t(lang, "time.zone_label", { city: cityName(tz, lang) }) + ")";
}

// Appointment time for the reminder, in the lead's language:
// "Wednesday, November 25 at 10:00 AM (New York time)" /
// "miércoles 25 de noviembre, 10:00 a. m. (hora de Bogotá)".
// Built by hand (not toLocaleString) so Node and Apps Script print the same.
function formatAppointment(appt, tz, lang) {
  var names = DATE_NAMES[lang === "es" ? "es" : "en"];
  var p = appt.date.split("-").map(Number);
  var hour = Math.floor(appt.minutes / 60);
  var h12 = hour % 12 === 0 ? 12 : hour % 12;
  var clock = h12 + ":" + pad2(appt.minutes % 60);
  var city = cityName(tz, lang);
  var day = names.days[weekdayOf(appt.date)];
  var month = names.months[p[1] - 1];
  if (lang === "es") {
    return day + " " + p[2] + " de " + month + ", " + clock + (hour < 12 ? " a. m." : " p. m.") +
      " (hora de " + city + ")";
  }
  return day + ", " + month + " " + p[2] + " at " + clock + (hour < 12 ? " AM" : " PM") + " (" + city + " time)";
}

// ===== src/lang.js =====
// Language helpers: detect a lead's language, look up UI strings, fold text.
//
// Copied from bilingual-sla-tracker (src/language.js and the t / tCount /
// foldText helpers in src/strings.js), not imported across repos. The
// detector word lists are the same; a few sales words were added
// (demo, invoice, factura, precio...).
//
// Why a word count and not a library: it runs unchanged in Apps Script and
// Node, and the owner can explain every rule. It is only used when the
// Language column is empty, and the queue then says "language guessed".

var EN_WORDS = toWordSet(
  "the and is are was were my i you your it its to of in for on with this that " +
  "have has had not cant can't dont don't didnt didn't doesnt doesn't wont won't " +
  "why what how when where do does did be been please thanks thank help hi hello " +
  "card account money charge charged payment transfer still yet never again from " +
  "at but there they we will would can get got know just an if or so after since " +
  "also need want which any all some it's im i'm sent pending login password " +
  "demo invoice invoices invoicing clients team see works work like looking");

var ES_WORDS = toWordSet(
  "el la los las del que y en un una es mi mis por para con se lo le su al pero " +
  "como cuando donde porque ya sin hay yo tu tengo puedo quiero necesito ayuda " +
  "tarjeta cuenta dinero cobro cargo pago transferencia gracias hola favor sigue " +
  "desde todavia nunca otra vez esta este estoy son fue muy mas hace dice pasa " +
  "dias cuanto cual tienen llega llego robaron perdi contrasena hicieron pedi " +
  "factura facturas facturar clientes equipo ver precio cuesta usando alguien");

var SPANISH_MARKS = "áéíóúñ¿¡";

function toWordSet(words) {
  var set = {};
  words.split(/\s+/).forEach(function (w) { if (w) set[w] = true; });
  return set;
}

// [englishScore, spanishScore] for a piece of text.
function languageScores(text) {
  var words = foldText(text).match(/[a-z']+/g) || [];
  var en = 0, es = 0;
  words.forEach(function (w) {
    if (EN_WORDS[w] === true) en++;
    if (ES_WORDS[w] === true) es++;
  });
  String(text || "").toLowerCase().split(/\s+/).forEach(function (w) {
    for (var i = 0; i < w.length; i++) {
      if (SPANISH_MARKS.indexOf(w[i]) !== -1) { es++; return; }
    }
  });
  return [en, es];
}

// "en", "es", "mixed" or "other".
function detectLanguage(text) {
  var scores = languageScores(text);
  var en = scores[0], es = scores[1];
  if (en === 0 && es === 0) return "other";
  if (Math.min(en, es) >= 2 && Math.min(en, es) / Math.max(en, es) >= 0.5) return "mixed";
  if (en === es) return "mixed";
  return en > es ? "en" : "es";
}

// Language for a lead's messages. The Language column wins. If it is empty,
// guess from notes + last reply ("guessed"). If there is nothing to go on,
// English, marked "check" so a person looks at it.
// Returns { lang: "en"|"es", note: ""|"guessed"|"check" }.
function leadLanguage(column, notes, lastReply) {
  var value = foldText(column);
  if (["en", "english", "ingles"].indexOf(value) !== -1) return { lang: "en", note: "" };
  if (["es", "spanish", "espanol"].indexOf(value) !== -1) return { lang: "es", note: "" };
  var guess = detectLanguage(String(notes || "") + " " + String(lastReply || ""));
  if (guess === "en" || guess === "es") return { lang: guess, note: "guessed" };
  return { lang: "en", note: "check" };
}

// UI string in `lang`, with "{name}" placeholders filled from vars.
function t(lang, key, vars) {
  var table = STRINGS[lang] || STRINGS.en;
  var text = key in table ? table[key] : key;
  return text.replace(/\{(\w+)\}/g, function (whole, name) {
    return vars && name in vars ? String(vars[name]) : whole;
  });
}

// Singular or plural form: tCount("en", "x", 3) uses "x_other".
function tCount(lang, key, count, vars) {
  var all = Object.assign({ count: count }, vars || {});
  return t(lang, key + (count === 1 ? "_one" : "_other"), all);
}

// Lowercase, no accents, curly apostrophes made straight, single spaces:
// "No me escriban MÁS" and "no me escriban mas" match.
function foldText(text) {
  return String(text == null ? "" : text)
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[‘’´`]/g, "'")
    .toLowerCase()
    .replace(/\s+/g, " ")
    .trim();
}

// Find the id behind a cell value: "No contactar", "do not contact" and
// "do_not_contact" all give "do_not_contact". "" when nothing matches.
function idFromLabel(kind, value, ids, extra) {
  var folded = foldText(value);
  if (!folded) return "";
  for (var i = 0; i < ids.length; i++) {
    var id = ids[i];
    var names = [id, id.replace(/_/g, " "), STRINGS.en[kind + "." + id], STRINGS.es[kind + "." + id]]
      .concat((extra && extra[id]) || []);
    for (var j = 0; j < names.length; j++) {
      if (foldText(names[j]) === folded) return id;
    }
  }
  return "";
}

// ===== src/mask.js =====
// Copied from bilingual-sla-tracker (src/mask.js), which ported it from
// bilingual-faq-chatbot (chatbot/mask.py). Same patterns; not imported
// across repos.
//
// Why here: reps paste whatever the lead wrote into Notes and Last reply,
// sometimes with a card number or a one-time code in it. The queue, the
// Draft preview tab and output/drafts.html show notes only after
// maskSensitive(). Notes are never pasted into a message at all.
// Limits (same as mask.py): names, account numbers and passwords typed with
// no label ("Sunflower2024! log me in") are NOT masked. PASSWORD_RE also
// hides punctuation stuck to the password, and CODE_RE can hide harmless
// numbers ("error code 5003"). Hiding too much is safer than too little.
// JavaScript note: \b only knows ASCII letters, so accented words are written
// out in full in the patterns below.

var CARD_MASK = "[CARD NUMBER MASKED]";
var CODE_MASK = "[CODE MASKED]";
var PASSWORD_MASK = "[PASSWORD MASKED]";

// 13 to 19 digits, optionally split by spaces, dashes or dots ("0000 1234 ...").
var CARD_RE = /(?<!\d)(?:\d[ .-]?){12,18}\d(?!\d)/g;

// "CVV 123", "cvc: 1234", "código de seguridad 123".
var CVV_RE = /\b(cvv2?|cvc|security code|c[oó]digo de seguridad)\b(\D{0,12}?)(\d{3,4})(?!\d)/gi;

// "code 482913", "el código es 482913", "PIN 1234", "OTP: 9921",
// and codes typed in two groups: "código 123 456", "code 123-456".
var CODE_RE = new RegExp(
  "\\b(one[- ]time code|verification code|otp|code|c[oó]digo|clave|pin|passcode|token)(?![a-z])" +
  "(\\D{0,25}?)(\\d{3,4}[ -]\\d{3,4}|\\d{4,8})(?!\\d)", "gi");

// A password typed after a label ("my password is Sunflower2024!",
// "contraseña: Girasol2024", "mi clave es ..."). Only the next word is hidden.
// Common words after "is" / "es" are left alone, so "my password is wrong"
// and "mi contraseña es incorrecta" stay readable.
var NOT_A_PASSWORD =
  "wrong|incorrect|invalid|not|expired|correct|right|too|still|being|blocked|locked|the|a|an|my" +
  "|same|old|new|fine|ok|okay|good|bad|weak|strong|case|different|working|broken|gone|missing" +
  "|required|needed|and|but|or|in|on|for|that|this|it|also|very|already|now|no|never|reset" +
  "|incorrecta|incorrecto|correcta|correcto|invalida|inválida|mala|malo|muy|demasiado|la|el|una" +
  "|un|mi|igual|misma|mismo|bloqueada|vieja|nueva|diferente|otra|corta|larga|segura|debil|débil" +
  "|que|y|o|pero|para|de|en|ya|ahora|tambien|también|nunca";
// (?![\wáéíóúñ]) plays the role of Python's Unicode \b after the word.
var PASSWORD_RE = new RegExp(
  "\\b(password|passcode|pass word|pw|pwd|contrase[nñ]a|clave)" +
  "(\\s*[:=]\\s*|\\s+(?:is|es)\\s*:?\\s*)" +
  "(?!(?:" + NOT_A_PASSWORD + ")(?![\\wáéíóúñ]))(\\S{3,})", "gi");

// Returns { text: masked text, count: number of items masked }.
function maskSensitive(text) {
  var count = 0;
  function replaceWith(mask) {
    return function () { count++; return mask; };
  }
  function keepLabelAs(mask) {
    return function (whole, label, between) { count++; return label + between + mask; };
  }
  var out = String(text == null ? "" : text);
  // Cards first (longest digit runs), then CVVs, then passwords before codes,
  // so "mi clave es 4821" is hidden as a password.
  out = out.replace(CARD_RE, replaceWith(CARD_MASK));
  out = out.replace(CVV_RE, keepLabelAs(CODE_MASK));
  out = out.replace(PASSWORD_RE, keepLabelAs(PASSWORD_MASK));
  out = out.replace(CODE_RE, keepLabelAs(CODE_MASK));
  return { text: out, count: count };
}

// ===== src/optout.js =====
// Opt-out / do-not-contact detection and the suppression list.
//
// A lead is opted out when ANY of these is true:
//   - Status is "Do not contact" / "No contactar"
//   - the Opt-out column says yes
//   - their last reply contains an opt-out phrase (lists below)
//   - their email or phone is on the Suppression tab, or belongs to another
//     row that opted out (so a duplicate row for the same person is blocked)
// Opt-out beats every other status, including Booked.
//
// The phrase lists lean toward over-blocking on purpose: "Can we stop by?"
// is flagged too. A missed opt-out costs a complaint; a false alarm costs a
// rep 10 seconds to check. `npm run eval` shows both on labeled samples.

// Phrases are matched on folded text (lowercase, no accents, punctuation as
// spaces), as whole words. This is a keyword list: it WILL miss some
// wordings. That is why every reply that is not caught here still goes to a
// person ("Reply needs a person", see followup.js), never to an automatic
// follow-up. The first items in each list are from the approved plan; the
// rest were added after review.
var OPT_OUT_PHRASES = {
  en: [
    "unsubscribe", "stop", "remove me", "don't contact me", "do not email", "not interested",
    "dont contact me", "do not contact me", "don't email", "dont email", "take me off",
    "opt out", "opt me out", "remove us", "take us off", "mailing list", "leave me alone",
    "do not contact us", "don't contact us", "dont contact us", "do not call", "don't call",
    "dont call", "no thanks",
  ],
  es: [
    "darme de baja", "dar de baja", "no me contacten", "no me escriban", "no me llamen",
    "dejen de escribirme", "no estoy interesado", "no estoy interesada", "cancelar suscripción",
    "cancelar mi suscripción", "no me interesa", "no nos escriban", "no nos contacten",
    "no nos llamen", "no me manden", "no me envíen", "no quiero recibir", "bórrenme", "borrarme",
    "bórrennos", "no, gracias",
    // Third person, as a rep writes it in Notes after a call.
    "no le escribamos", "no le escriban", "no le llamemos", "no le llamen", "no le contactemos",
    "no le contacten", "no lo contacten", "no la contacten", "no lo llamen", "no la llamen",
  ],
};

// Spanish verb forms that vary too much for a plain list:
// "sáquenme de su lista", "sacarme de la lista", "quítenme de esta lista"...
var OPT_OUT_PATTERNS = [
  /(^| )(sacar|sacarme|sacarnos|saquenme|saquennos|quitar|quitarme|quitenme|borrar|borrarnos|borrenme) de (la|su|sus|esta|tu|vuestra) lista($| )/,
];

// "Baja" on its own is a common one-word opt-out reply in Spanish. Inside a
// sentence ("¿baja el precio?") it is not, so it only counts alone.
var STANDALONE_OPT_OUT = ["baja", "stop", "unsubscribe"];

// Folded text with punctuation turned into spaces ("No, gracias." ->
// "no gracias"). Apostrophes stay, so "don't" is one word.
function plainWords(text) {
  return foldText(text).replace(/[^a-z0-9']+/g, " ").trim();
}

// Whole-phrase test. Letters, digits and apostrophes count as part of a
// word, so "stop" does not match "stopped" or "nonstop".
function containsPhrase(text, phrase) {
  var p = plainWords(phrase).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return new RegExp("(^| )" + p + "($| )").test(plainWords(text));
}

// The opt-out phrase found in a reply or a note, or "".
function optOutPhrase(reply) {
  var words = plainWords(reply);
  if (!words) return "";
  if (STANDALONE_OPT_OUT.indexOf(words) !== -1) return words;
  var all = OPT_OUT_PHRASES.en.concat(OPT_OUT_PHRASES.es);
  for (var i = 0; i < all.length; i++) {
    if (containsPhrase(words, all[i])) return all[i];
  }
  for (var j = 0; j < OPT_OUT_PATTERNS.length; j++) {
    var m = OPT_OUT_PATTERNS[j].exec(words);
    if (m) return m[0].trim();
  }
  return "";
}

function isOptOutYes(value) {
  return OPT_OUT_YES.indexOf(foldText(value)) !== -1;
}

// Why this lead's own row says "do not contact": { key, vars } or null.
function ownOptOut(lead) {
  if (lead.status === "do_not_contact") return { key: "optout.status", vars: {} };
  if (isOptOutYes(lead.opt_out)) return { key: "optout.column", vars: {} };
  var phrase = optOutPhrase(lead.last_reply);
  if (phrase) return { key: "optout.reply", vars: { phrase: phrase } };
  // Reps log phone opt-outs in Notes ("Called: said do not contact me").
  var note = optOutPhrase(lead.notes);
  if (note) return { key: "optout.notes", vars: { phrase: note } };
  return null;
}

// Digits only, so "+1-555-0142" and "1 555 0142" match. Very short numbers
// are ignored (too likely to collide).
function normalizePhone(phone) {
  var digits = String(phone == null ? "" : phone).replace(/\D/g, "");
  return digits.length >= 7 ? digits : "";
}

function normalizeEmail(email) {
  return String(email == null ? "" : email).trim().toLowerCase();
}

// Suppression list from the Suppression tab rows (without header) plus every
// lead that opted out in this sheet. Returns { emails: {}, phones: {}, added }
// where `added` lists the NEW entries for the tab: { email, phone, reason, date }.
function buildSuppression(leads, existingRows, today) {
  var list = { emails: {}, phones: {}, added: [] };
  (existingRows || []).forEach(function (row) {
    var email = normalizeEmail(row[0]);
    var phone = normalizePhone(row[1]);
    if (email) list.emails[email] = true;
    if (phone) list.phones[phone] = true;
  });
  leads.forEach(function (lead) {
    var why = ownOptOut(lead);
    if (!why) return;
    var email = normalizeEmail(lead.email);
    var phone = normalizePhone(lead.phone);
    var isNew = (email && !list.emails[email]) || (phone && !list.phones[phone]);
    if (email) list.emails[email] = true;
    if (phone) list.phones[phone] = true;
    if (isNew) list.added.push({ email: lead.email, phone: lead.phone, reason: why, date: today });
  });
  return list;
}

function isSuppressed(lead, list) {
  var email = normalizeEmail(lead.email);
  var phone = normalizePhone(lead.phone);
  return Boolean((email && list.emails[email]) || (phone && list.phones[phone]));
}

// ===== src/report.js =====
// Turn decisions into what people read: reasons, the queue table, the draft
// preview, the summary counts, and the values written back to the Leads tab.
// `ui` is the language of the labels (the sales team's language), which is
// separate from each draft's language (the lead's).

// A reason as text: "missing first name" / "falta nombre".
function reasonText(reason, ui) {
  if (!reason) return "";
  var vars = Object.assign({}, reason.vars);
  if (vars.field) vars.field = t(ui, "field." + vars.field);
  if (vars.category) vars.category = t(ui, "category." + vars.category);
  return t(ui, reason.key, vars);
}

function allReasons(d, ui) {
  return [d.reason].concat(d.moreReasons || []).filter(Boolean)
    .map(function (r) { return reasonText(r, ui); }).join("; ");
}

// "now: Tue Nov 24, 10:00 (New York time)" or, for a lead outside its local
// hours, "next window: ..." (style "send.waits" for the demo page).
function sendAfterText(d, ui, waitStyle) {
  if (!d.sendAfter) return "";
  var s = d.sendAfter;
  var key = s.inWindow ? "send.now" : (waitStyle || "send.next");
  return t(ui, key, { time: shortLocalTime(s.date, s.minutes, s.tz, ui) });
}

// Notes and last reply as shown to the team: masked, never in a message.
function maskedNotes(lead) {
  var text = lead.notes;
  if (lead.last_reply) text += (text ? " | " : "") + "“" + lead.last_reply + "”";
  return maskSensitive(text).text;
}

function flagsText(d, ui) {
  return d.flags.map(function (key) { return t(ui, key); }).join(" ");
}

function countDecisions(decisions) {
  var c = { drafts: 0, waiting: 0, held: 0, heldDetail: [], opted_out: 0, support: 0,
    reminders: 0, needs_person: 0, not_due: 0, stopped: 0 };
  var detail = {};
  decisions.forEach(function (d) {
    if (d.action === "draft") c.drafts++;
    if (d.action === "waiting") c.waiting++;
    if (d.action === "reminder") c.reminders++;
    if (d.action === "opted_out") c.opted_out++;
    if (d.action === "support") c.support++;
    if (d.action === "needs_person") c.needs_person++;
    if (d.action === "not_due") c.not_due++;
    if (d.action === "stopped") c.stopped++;
    if (d.action === "hold") {
      c.held++;
      // Group by reason kind (and field), not by the exact bad value.
      var id = d.reason.key + "|" + (d.reason.vars.field || "");
      if (!(id in detail)) { detail[id] = c.heldDetail.length; c.heldDetail.push({ reason: d.reason, count: 0 }); }
      c.heldDetail[detail[id]].count++;
    }
  });
  return c;
}

// The two summary lines for the terminal and the Summary tab.
function summaryLines(counts, ui) {
  var held = counts.heldDetail.map(function (h) {
    // Kinds whose text includes the bad value have a "_short" label.
    var short = h.reason.key + "_short";
    var r = short in STRINGS[ui] ? { key: short, vars: {} } : h.reason;
    return reasonText(r, ui) + " " + h.count;
  });
  return [
    t(ui, "summary.line", {
      drafts: counts.drafts, waiting: counts.waiting,
      held: counts.held, held_detail: held.length ? " (" + held.join(", ") + ")" : "",
      opted_out: counts.opted_out, support: counts.support, reminders: counts.reminders,
    }),
    t(ui, "summary.line2", { needs_person: counts.needs_person, not_due: counts.not_due, stopped: counts.stopped }),
  ];
}

// One row per lead: what happened and why. Same table for output/queue.csv
// and the Queue tab.
function queueTable(decisions, ui) {
  var header = [t(ui, "queue.row"), t(ui, "header.first_name"), t(ui, "header.email"),
    t(ui, "header.status"), t(ui, "queue.action"), t(ui, "queue.reason"), t(ui, "queue.template"),
    t(ui, "queue.draft_language"), t(ui, "queue.send_after"), t(ui, "queue.subject"),
    t(ui, "queue.flags"), t(ui, "queue.notes")];
  return [header].concat(decisions.map(function (d) {
    // Status exactly as typed in the sheet, so an unrecognised one is visible.
    return [d.row, d.lead.first_name, d.lead.email, d.lead.statusRaw,
      t(ui, "action." + d.action), allReasons(d, ui), d.template ? t(ui, "template." + d.template) : "",
      d.draft ? d.lang.toUpperCase() : "", sendAfterText(d, ui), d.draft ? d.draft.subject : "",
      flagsText(d, ui), maskedNotes(d.lead)];
  }));
}

// Drafts only, with the full body: the Draft preview tab (DRY_RUN).
function previewTable(decisions, ui) {
  var rows = [[t(ui, "queue.row"), t(ui, "html.to"), t(ui, "queue.subject"), "Body / Cuerpo",
    t(ui, "queue.send_after"), t(ui, "queue.flags")]];
  decisions.forEach(function (d) {
    if (d.draft) rows.push([d.row, d.draft.to, d.draft.subject, d.draft.body, sendAfterText(d, ui), flagsText(d, ui)]);
  });
  return rows;
}

// Summary tab: title, the two lines, then one count per action.
function summaryTable(counts, ui, date) {
  var rows = [[t(ui, "summary.title", { date: date })]];
  summaryLines(counts, ui).forEach(function (line) { rows.push([line]); });
  rows.push([t(ui, "queue.action"), t(ui, "summary.count")]);
  [["draft", counts.drafts], ["reminder", counts.reminders], ["waiting", counts.waiting], ["hold", counts.held],
    ["opted_out", counts.opted_out], ["support", counts.support], ["needs_person", counts.needs_person],
    ["not_due", counts.not_due], ["stopped", counts.stopped]].forEach(function (pair) {
    rows.push([t(ui, "action." + pair[0]), pair[1]]);
  });
  return rows;
}

// New Suppression tab rows: email, phone, reason (in `ui`), date added.
function suppressionRows(added, ui) {
  return added.map(function (s) { return [s.email, s.phone, reasonText(s.reason, ui), s.date]; });
}

// Write-back: { header, map, columns: { key: [value per data row] } }.
// Missing write-back columns are added at the end with headers in `lang`.
// Only rows with a decision change; every other cell keeps its value.
function columnUpdates(table, decisions, lang) {
  var header = table[0].slice();
  var map = mapColumns(header, lang);
  WRITE_BACK_COLUMNS.forEach(function (key) {
    if (!(key in map)) { map[key] = header.length; header.push(t(lang, "header." + key)); }
  });
  var byRow = {};
  decisions.forEach(function (d) { byRow[d.row] = d.updates; });
  var columns = {};
  WRITE_BACK_COLUMNS.forEach(function (key) {
    columns[key] = table.slice(1).map(function (cells, i) {
      var updates = byRow[i + 2];
      if (updates && key in updates) return updates[key];
      var v = cells[map[key]];
      return v == null ? "" : v;
    });
  });
  return { header: header, map: map, columns: columns };
}

// The table after write-back (used by the demo and the tests).
function applyUpdates(table, decisions, lang) {
  var u = columnUpdates(table, decisions, lang);
  var out = [u.header].concat(table.slice(1).map(function (cells) {
    var row = cells.slice();
    while (row.length < u.header.length) row.push("");
    return row;
  }));
  Object.keys(u.columns).forEach(function (key) {
    u.columns[key].forEach(function (v, i) { out[i + 1][u.map[key]] = v; });
  });
  return out;
}

// ===== src/strings.js =====
// Every text the tool shows to the sales team, in English and Spanish, in one
// place. (Messages to leads are in templates.js.) Spanish: neutral Latin
